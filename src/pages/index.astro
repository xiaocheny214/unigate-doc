---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CodeGroup } from '../components/mdx/CodeGroup';

// 1. Codex 接入示例
const codexSnippet = `# ~/.codex/config.toml
model_provider = "OpenAI"
model = "gemini-3.8-flash-high"
review_model = "gemini-3.8-flash-high"
disable_response_storage = true
network_access = "enabled"

[model_providers.OpenAI]
name = "OpenAI"
base_url = "https://unigate.top/v1"
wire_api = "responses"
requires_openai_auth = true

# ~/.codex/auth.json
{
  "OPENAI_API_KEY": "sk-unigate-xxxxxxxx"
}

$ codex "重构认证中间件，并保持测试通过"
✓ 14 个文件已修改 · 38 项测试通过 · 本次消耗 USD 0.41`;

// 2. Claude Code 接入示例
const claudeCodeSnippet = `# macOS / Linux
export ANTHROPIC_BASE_URL="https://unigate.top/v1"
export ANTHROPIC_AUTH_TOKEN="sk-unigate-xxxxxxxx"
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# ~/.claude/settings.json
{
  "env": {
    "ANTHROPIC_BASE_URL": "https://unigate.top/v1",
    "ANTHROPIC_AUTH_TOKEN": "sk-unigate-xxxxxxxx",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  }
}

$ claude "重构认证中间件，并保持测试通过"
✓ 14 个文件已修改 · 38 项测试通过 · 本次消耗 USD 0.41`;

// 3. OpenCode 接入示例
const opencodeSnippet = `# ~/.config/opencode/opencode.json
{
  "$schema": "https://opencode.ai/config.json",
  "model": "unigate/gemini-3.8-flash-high",
  "small_model": "unigate/gemini-3.8-flash-high",
  "provider": {
    "unigate": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "UniGate",
      "options": {
        "baseURL": "https://unigate.top/v1",
        "apiKey": "sk-unigate-xxxxxxxx"
      },
      "models": {
        "gemini-3.8-flash-high": {
          "name": "Gemini 3.8 Flash High",
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "options": {
            "store": false
          }
        }
      }
    }
  },
  "agent": {
    "build": {
      "options": {
        "store": false
      }
    },
    "plan": {
      "options": {
        "store": false
      }
    }
  }
}

$ opencode "重构认证中间件，并保持测试通过"
✓ 14 个文件已修改 · 38 项测试通过 · 本次消耗 USD 0.41`;

// 4. OpenAI Compatible 接入示例
const openAiCompatibleSnippet = `# Cline / Trae / CCSwitch
API Provider: OpenAI Compatible
Base URL: https://unigate.top/v1
API Key: sk-unigate-xxxxxxxx
Model ID: gemini-3.8-flash-high

$ aicli "重构认证中间件，并保持测试通过"
✓ 14 个文件已修改 · 38 项测试通过 · 本次消耗 USD 0.41`;

const clientItems = [
  {
    label: 'Codex',
    badge: 'TOML + JSON',
    sublabel: '~/.codex/config.toml · ~/.codex/auth.json',
    code: codexSnippet,
    lang: 'toml',
    highlightLines: [3, 10, 16, 20],
    footerNote: '实测日跑 7000万 Token · 稳定输出'
  },
  {
    label: 'Claude Code',
    badge: 'Shell + JSON',
    sublabel: 'shell · ~/.claude/settings.json',
    code: claudeCodeSnippet,
    lang: 'json',
    highlightLines: [2, 3, 9, 10],
    footerNote: '完全兼容 Anthropic Messages 协议'
  },
  {
    label: 'OpenCode',
    badge: 'JSON',
    sublabel: '~/.config/opencode/opencode.json',
    code: opencodeSnippet,
    lang: 'json',
    highlightLines: [4, 12, 13, 17],
    footerNote: '原生适配 AI-SDK 开源生态'
  },
  {
    label: 'OpenAI Compatible',
    badge: 'Cline · Trae · CCSwitch',
    sublabel: '兼容主流 IDE 插件与客户端',
    code: openAiCompatibleSnippet,
    lang: 'yaml',
    highlightLines: [2, 3, 4, 5],
    footerNote: '支持任意标准 OpenAI 协议客户端'
  }
];
---

<BaseLayout title="开发者友好的极速 AI API Gateway">
  <!-- Hero Section -->
  <section class="relative pt-16 pb-16 overflow-hidden bg-grid-pattern border-b border-slate-200/60">
    <div class="max-w-5xl mx-auto px-4 text-center space-y-6">

      <!-- Top Protocol Compatibility Notice -->
      <div class="flex items-center justify-center gap-2 text-[12px] sm:text-xs font-medium text-slate-500 tracking-wide">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-600 border border-slate-200">
          <span class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-pulse"></span>
          兼容主流 API 协议
        </span>
        <span class="text-slate-400 font-mono hidden sm:inline">|</span>
        <span class="text-slate-600 font-medium">Chat Completions</span>
        <span class="text-slate-300">·</span>
        <span class="text-slate-600 font-medium">Anthropic Messages</span>
        <span class="text-slate-300">·</span>
        <span class="text-slate-600 font-medium">Gemini Native generateContent</span>
      </div>

      <!-- Announcement Pill -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-blue-200/80 bg-blue-50/80 text-xs text-blue-700 shadow-xs">
        <span class="font-semibold">⚡ 开业特惠</span>
        <span class="w-1 h-1 rounded-full bg-blue-400"></span>
        <span>Pro 套餐 $5/月 · 日供高达 7000 万 Token</span>
      </div>

      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-slate-900 leading-[1.15]">
        优选前沿 AI 模型，<br/>
        <span class="text-blue-600">
          无缝接入主流开发工具
        </span>
      </h1>

      <p class="max-w-2xl mx-auto text-base sm:text-lg text-slate-600 leading-relaxed">
        UniGate 为 Cursor、Claude Code、Codex 及开源客户端提供高可用 AI API 路由。统一 Key、稳定配额与极致吞吐，每天仅需一块钱，告别官方限额焦虑。
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap items-center justify-center gap-4 pt-3">
        <a
          href="/docs/quickstart"
          class="px-6 py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold shadow-sm hover:shadow transition"
        >
          查看接入文档
        </a>
        <a
          href="#pricing"
          class="px-6 py-3 rounded-xl border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 font-semibold shadow-xs transition"
        >
          查看 Pro 套餐 ($5/月)
        </a>
      </div>

      <!-- Feature Pill Badges -->
      <div class="flex flex-wrap items-center justify-center gap-2 pt-4 text-xs text-slate-500 font-medium">
        <span class="px-3 py-1 rounded-full bg-slate-100 border border-slate-200/70">✨ 主打 Gemini-3.8-Flash-High / 3.1-Pro-High</span>
        <span class="px-3 py-1 rounded-full bg-slate-100 border border-slate-200/70">⚡ 实测日跑 7000万 Token</span>
        <span class="px-3 py-1 rounded-full bg-slate-100 border border-slate-200/70">🛠️ 完美适配各类代码编辑器客户端</span>
        <span class="px-3 py-1 rounded-full bg-slate-100 border border-slate-200/70">🛡️ 专线高可用保障</span>
      </div>
    </div>
  </section>

  <!-- Interactive Config Switcher (Fenno-style Quick Config) -->
  <section class="max-w-4xl mx-auto px-4 py-16">
    <div class="text-center mb-10">
      <div class="text-xs font-bold text-blue-600 uppercase tracking-wider">极简接入</div>
      <h2 class="text-2xl font-extrabold text-slate-900 mt-1">常用工具与客户端配置示例</h2>
      <p class="text-sm text-slate-500 mt-1.5">所有工具共用同一个 API Key 和 Base URL，零迁移成本</p>
    </div>

    <!-- 终端风格外壳与精致阴影排布 -->
    <div class="relative bg-white rounded-2xl shadow-xl shadow-slate-200/50 border border-slate-200/70 overflow-hidden">
      <!-- 终端风格顶部栏 -->
      <div class="h-11 bg-slate-50/90 border-b border-slate-200/80 flex items-center justify-between px-4">
        <div class="flex items-center gap-2">
          <div class="flex gap-1.5">
            <div class="w-3 h-3 rounded-full bg-rose-400/80"></div>
            <div class="w-3 h-3 rounded-full bg-amber-400/80"></div>
            <div class="w-3 h-3 rounded-full bg-emerald-400/80"></div>
          </div>
          <div class="text-xs font-medium text-slate-500 font-mono ml-2">unigate-client-setup</div>
        </div>
        <div class="text-[11px] text-slate-400 font-mono hidden sm:block">
          Endpoint: https://unigate.top/v1
        </div>
      </div>
      <!-- 代码展示区 -->
      <div class="p-2 sm:p-3 bg-slate-900">
        <CodeGroup
          client:load
          items={clientItems}
        />
      </div>
    </div>
  </section>

  <!-- Pricing & Promotional Copy Section (Clean Cards) -->
  <section id="pricing" class="max-w-6xl mx-auto px-4 py-16 border-t border-slate-200/70">
    <div class="text-center mb-12">
      <div class="text-xs font-bold text-blue-600 uppercase tracking-wider">价格与权益</div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-1">价格亲民，量大管饱</h2>
      <p class="text-sm text-slate-500 mt-2">专为高频调用与大模型工具用户量身打造的高配额矩阵</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Card 1: Pricing -->
      <div class="p-7 rounded-2xl border-2 border-blue-600 bg-white shadow-sm relative flex flex-col justify-between">
        <div class="absolute -top-3.5 right-6 px-3 py-0.5 rounded-full bg-blue-600 text-white text-xs font-bold uppercase tracking-wider shadow-xs">
          开业特惠
        </div>
        <div>
          <div class="text-xs font-semibold text-blue-600 uppercase tracking-wider">超值订阅</div>
          <h3 class="text-xl font-extrabold text-slate-900 mt-0.5">Pro 极速套餐</h3>
          <div class="mt-4 flex items-baseline gap-2">
            <span class="text-4xl font-extrabold text-slate-900">$5</span>
            <span class="text-sm text-slate-500 font-medium">/ 月</span>
            <span class="text-xs line-through text-slate-400">原价 $8</span>
          </div>
          <p class="text-xs text-slate-500 mt-2 leading-relaxed">
            折合每天只需一块钱多一点，即可尽情享受大模型高并发调用！
          </p>

          <div class="my-5 border-t border-slate-100"></div>

          <ul class="space-y-3 text-xs text-slate-700">
            <li class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✓</span> 日额度：<strong class="text-slate-900">$40</strong>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✓</span> 周额度：<strong class="text-slate-900">$300</strong>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✓</span> 月额度：<strong class="text-slate-900">$1299</strong>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✓</span> 全面兼容 OpenAI 协议及主流客户端
            </li>
          </ul>
        </div>

        <a
          href="https://unigate.top"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 block text-center py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm transition shadow-xs"
        >
          前往官网开通
        </a>
      </div>

      <!-- Card 2: Gemini Flash High -->
      <div class="p-7 rounded-2xl border border-slate-200 bg-white shadow-xs flex flex-col justify-between hover:border-slate-300 transition">
        <div>
          <div class="text-xs font-semibold text-emerald-600 uppercase tracking-wider">性价比之王</div>
          <h3 class="text-xl font-extrabold text-slate-900 mt-0.5">Gemini-3.8-Flash-High</h3>
          <p class="text-xs text-slate-500 mt-2 leading-relaxed">
            兼具顶级推理性能与闪电般的响应延迟，长文本及高频调用的首选主力。
          </p>

          <div class="my-5 border-t border-slate-100"></div>

          <ul class="space-y-3 text-xs text-slate-700">
            <li class="flex items-start gap-2">
              <span class="text-blue-600 font-bold">⚡</span> <span><strong>超大吞吐</strong>：实测日均最高跑出 7000 万 Token。</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-blue-600 font-bold">🏆</span> <span><strong>实力碾压</strong>：代码与复杂上下文表现卓越，超越多数旗舰开源模型。</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-blue-600 font-bold">💼</span> <span><strong>生态适配</strong>：完美充当 Codex、Claude Code、OpenCode 等的高性能后台引擎。</span>
            </li>
          </ul>
        </div>

        <a href="/docs/quickstart" class="mt-8 inline-block text-xs text-blue-600 hover:text-blue-700 font-semibold">
          查看快速接入指南 →
        </a>
      </div>

      <!-- Card 3: Gemini 3.1 Pro High & Claude -->
      <div class="p-7 rounded-2xl border border-slate-200 bg-white shadow-xs flex flex-col justify-between hover:border-slate-300 transition">
        <div>
          <div class="text-xs font-semibold text-purple-600 uppercase tracking-wider">深度推理旗舰</div>
          <h3 class="text-xl font-extrabold text-slate-900 mt-0.5">Gemini-3.1-Pro-High</h3>
          <p class="text-xs text-slate-500 mt-2 leading-relaxed">
            专为超大上下文、深度逻辑思考、高难度系统级重构准备的强力算力节点。
          </p>

          <div class="my-5 border-t border-slate-100"></div>

          <ul class="space-y-3 text-xs text-slate-700">
            <li class="flex items-start gap-2">
              <span class="text-purple-600 font-bold">✨</span> <span><strong>深层思考能力</strong>：多步骤复杂任务与极端长代码库分析。</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-purple-600 font-bold">🛡️</span> <span><strong>专线稳定</strong>：高可用保障，告别官方账号被封困扰。</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-purple-600 font-bold">🧩</span> <span><strong>双模型主打</strong>：与 Gemini-3.8-Flash-High 组成黄金搭档。</span>
            </li>
          </ul>
        </div>

        <a href="/docs/pricing-models" class="mt-8 inline-block text-xs text-blue-600 hover:text-blue-700 font-semibold">
          查看全部可用模型清单 →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
