---
interface Props {
  showDocsNav?: boolean;
}
const { showDocsNav = true } = Astro.props;
---

<header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/80 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <div class="flex items-center gap-6">
      <a href="/" class="flex items-center gap-2.5 font-bold text-lg text-slate-900 tracking-tight hover:opacity-90 transition">
        <img src="/logo.svg" alt="UniGate Logo" class="h-8 w-auto" />
        <span class="flex items-center gap-1.5">
          UniGate
          <span class="text-[11px] px-2 py-0.5 rounded-full bg-blue-50 text-blue-700 font-medium border border-blue-200/60">
            Docs
          </span>
        </span>
      </a>
      {showDocsNav && (
        <nav class="hidden md:flex items-center gap-6 text-sm text-slate-600 font-medium">
          <a href="/docs/quickstart" class="hover:text-blue-600 transition">快速开始</a>
          <a href="/docs/pricing-models" class="hover:text-blue-600 transition">模型与定价</a>
        </nav>
      )}
    </div>
    <div class="flex items-center gap-3">
      <a
        href="https://unigate.top"
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs px-3.5 py-1.5 rounded-lg border border-slate-200 bg-white text-slate-700 font-medium hover:bg-slate-50 hover:border-slate-300 transition shadow-xs"
      >
        管理控制台
      </a>
      <a
        href="/#pricing"
        class="text-xs px-3.5 py-1.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-medium shadow-sm transition"
      >
        💥 Pro $5/月特惠
      </a>
    </div>
  </div>
</header>
